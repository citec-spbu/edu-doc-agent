# Скопируйте в .env и заполните.
# Файл .env в git не попадает.

# --- База данных ---
# Указывайте пароль как есть, без URL-кодирования.
# Буквальный $NAME в общем .env для Compose и Pydantic: одинарные кавычки,
# например POSTGRES_PASSWORD='synthetic@pass%40$NAME'.
# Буквальный ${NAME} передавайте через окружение процесса: Pydantic может
# интерполировать эту форму в .env даже внутри одинарных кавычек.
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu
# Локальные команды по умолчанию используют localhost:5432, Compose — db:5432.
# Для локального подключения к другой БД можно задать полный DATABASE_URL.

# --- URL для подключения к Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Heartbeat и Reconciler ---
# Оба RUN_STALE_* порога: > 0 и <= 31536000 секунд (365 дней).
# Интервал обновления пульса активной задачи (секунды)
RUN_HEARTBEAT_INTERVAL_SECONDS=30
# Через сколько секунд без пульса 'running' считается зависшим
# Должно быть >= 2 * RUN_HEARTBEAT_INTERVAL_SECONDS (проверяется при старте)
RUN_STALE_RUNNING_SECONDS=120
# Через сколько секунд 'queued' без старта считается зависшим
RUN_STALE_QUEUED_SECONDS=120
# Лимит восстановлений Reconciler'ом до перевода в 'failed' (poison pill)
RUN_MAX_RECONCILE_ATTEMPTS=3

# --- Данные ---
# Путь к папке с реальными документами ОП на вашей машине.
# Реальные документы в git не кладём (см. data/README.md).
DATA_DIR=
# Папка для загруженных файлов и сформированных отчётов.
# Локально по умолчанию ./storage, в Docker — /app/storage.
STORAGE_DIR=storage
# Максимальный размер одного загружаемого файла в байтах (по умолчанию 50 МБ)
MAX_UPLOAD_FILE_BYTES=52428800

# --- LLM ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# OpenAI-совместимый эндпоинт (LiteLLM), например https://host/v1
LLM_BASE_URL=
# Лимит запросов в минуту у ключа (если есть). Без него клиент не выдерживает паузы между
# вызовами и упирается в 429 (у общего ключа проекта лимит 2 запроса в минуту).
LLM_RPM=
# Эмбеддинги для RAG (Ollama): пусто — bge-m3 на http://localhost:11434
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

# --- Приложение ---
LOG_LEVEL=INFO

# Скопируйте в .env и заполните.
# Файл .env в git не попадает.

# --- База данных ---
# Указывайте пароль как есть, без URL-кодирования.
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu
# Локальные команды по умолчанию используют localhost:5432, Compose — db:5432.
# Для локального подключения к другой БД можно задать полный DATABASE_URL.

# --- URL для подключения к Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Данные ---
# Путь к папке с реальными документами ОП на вашей машине.
# Реальные документы в git не кладём (см. data/README.md).
DATA_DIR=

# --- LLM ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# OpenAI-совместимый эндпоинт (LiteLLM), например https://host/v1
LLM_BASE_URL=
# Лимит запросов в минуту у ключа (если есть). Без него клиент не выдерживает паузы между
# вызовами и упирается в 429 (у общего ключа проекта лимит 2 запроса в минуту).
LLM_RPM=
EMBEDDING_MODEL=

# --- Приложение ---
LOG_LEVEL=INFO
